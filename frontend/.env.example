# Postgres serverless gratuito: Neon via Marketplace da Vercel (injeta sozinho)
# ou Supabase free (use a pooled URL :6543 aqui; a direct :5432 só p/ db:migrate)
DATABASE_URL=postgresql://user:password@host:5432/escola_db?pgbouncer=true&connection_limit=1
# Segredo JWT (obrigatório em produção)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
# Rate limit distribuído (opcional; sem isso usa fallback em memória)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
